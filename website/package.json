{
  "name": "ast-mcp-docs",
  "private": true,
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run scripts/dev.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "preview": "bun run scripts/preview.ts",
    "prepare": "bun run scripts/generate.ts",
    "test": "bun test --bail tests",
    "test:browser": "bun run scripts/test-browser.ts",
    "typecheck": "bun run prepare && bun check"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.44",
    "fumadocs-core": "16.17.3",
    "fumadocs-mdx": "^15.4.7",
    "fumadocs-ui": "16.17.3",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/bun": "1.4.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0"
  }
}
