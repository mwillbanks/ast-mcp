{
  "author": "Mike Willbanks",
  "bin": {
    "ast-mcp": "dist/ast-mcp.js"
  },
  "bugs": {
    "url": "https://github.com/mwillbanks/ast-mcp/issues"
  },
  "dependencies": {
    "@ast-grep/lang-bash": "0.0.8",
    "@ast-grep/lang-c": "0.0.6",
    "@ast-grep/lang-cpp": "0.0.6",
    "@ast-grep/lang-csharp": "0.0.6",
    "@ast-grep/lang-dart": "0.0.7",
    "@ast-grep/lang-elixir": "0.0.7",
    "@ast-grep/lang-go": "0.0.6",
    "@ast-grep/lang-java": "0.0.7",
    "@ast-grep/lang-kotlin": "0.0.7",
    "@ast-grep/lang-lua": "0.0.7",
    "@ast-grep/lang-markdown": "0.0.6",
    "@ast-grep/lang-php": "0.0.7",
    "@ast-grep/lang-python": "0.0.6",
    "@ast-grep/lang-ruby": "0.0.7",
    "@ast-grep/lang-rust": "0.0.7",
    "@ast-grep/lang-scala": "0.0.7",
    "@ast-grep/lang-sql": "0.0.8",
    "@ast-grep/lang-swift": "0.0.8",
    "@ast-grep/lang-toml": "0.0.9",
    "@ast-grep/lang-yaml": "0.0.6",
    "@ast-grep/napi": "0.45.3",
    "@huggingface/transformers": "4.2.0",
    "@lancedb/lancedb": "0.38.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "apache-arrow": "18.1.0",
    "diff-match-patch-ts": "^2.0.0",
    "dprint": "0.57.4",
    "parse5": "8.0.1",
    "tree-sitter-wasm": "1.1.8",
    "typescript-strada": "npm:@typescript/typescript6@6.0.2",
    "unbash": "^4.0.11",
    "web-tree-sitter": "0.27.0",
    "zod": "^4.6.2"
  },
  "description": "Zero-trust MCP file writes, native code intelligence, graph retrieval, hooks, and agent skills",
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@modelcontextprotocol/inspector": "^2.6.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.1",
    "fallow": "^3.25.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "files": [
    "dist",
    "src",
    "templates",
    "dprint.json",
    "README.md",
    "CONTRIBUTING.md",
    "logo.svg",
    "LICENSE"
  ],
  "homepage": "https://mwillbanks.github.io/ast-mcp/",
  "keywords": [
    "ast",
    "ast-grep",
    "coding-agents",
    "mcp",
    "model-context-protocol",
    "secure-code-editing"
  ],
  "license": "MIT",
  "name": "@mwillbanks/ast-mcp",
  "packageManager": "bun@1.4.2",
  "preferUnplugged": true,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwillbanks/ast-mcp.git"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check": "bun run tools:check && bun run templates:check && bun run prose:check && bun run format:check && bun run typecheck && bun run test",
    "check:coverage": "bun run tools:check && bun run templates:check && bun run prose:check && bun run format:check && bun run typecheck && bun run test:coverage",
    "dev": "bun run --watch src/index.ts",
    "dev:http": "bun run --watch src/http-entry.ts",
    "evals:check": "bun run templates/skills/ast-mcp/evals/validate.ts",
    "evals:measure": "bun run templates/skills/ast-mcp/evals/measure.ts",
    "evals:score": "bun run templates/skills/ast-mcp/evals/measure.ts --strict",
    "fallow": "fallow --skip health",
    "fallow:health": "fallow health",
    "format": "biome check . --write --unsafe --reporter concise --error-on-warnings",
    "format:check": "biome check . --reporter concise --error-on-warnings",
    "graphify:provision": "bun run scripts/provision-intelligence-comparators-cli.ts",
    "inspect": "bunx @modelcontextprotocol/inspector bun run src/index.ts",
    "inspect:http": "bunx @modelcontextprotocol/inspector",
    "intelligence:measure": "bun run scripts/benchmark-intelligence-baseline.ts",
    "intelligence:qualify": "bun run scripts/qualify-intelligence-deps.ts",
    "lint": "biome check . --reporter concise --error-on-warnings",
    "prepack": "bun run build",
    "prose:check": "bun run scripts/check-prose-cli.ts",
    "skill:check": "bunx skills-ref validate templates/skills/ast-mcp",
    "smoke:hosts": "bun run scripts/host-smoke.ts",
    "start": "bun run src/index.ts",
    "start:http": "bun run src/http-entry.ts",
    "templates:check": "bun run scripts/check-template-drift.ts",
    "templates:sync": "bun run scripts/check-template-drift.ts --write",
    "test": "bun test --bail --max-concurrency=1 --timeout=30000",
    "test:coverage": "bun test --coverage --bail --max-concurrency=1 --timeout=30000",
    "tools:check": "bun run scripts/verify-tools.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "sideEffects": false,
  "trustedDependencies": [
    "dprint"
  ],
  "type": "module",
  "version": "0.5.0"
}
