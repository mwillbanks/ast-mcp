{
  "name": "ast-mcp-docs",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.3"
  },
  "overrides": {
    "@parcel/watcher": "2.6.0"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run scripts/dev.ts",
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "lint": "bun run format:check && bun run typecheck",
    "preview": "bun run scripts/preview.ts",
    "prepare": "bun run scripts/generate.ts",
    "test": "bun test --bail tests",
    "test:browser": "bun run scripts/test-browser.ts",
    "typecheck": "bun run prepare && bun check --no-script"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.45",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "^15.4.9",
    "fumadocs-ui": "16.17.7",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/bun": "1.4.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2"
  }
}
