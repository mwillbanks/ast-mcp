{
  "author": "Mike Willbanks",
  "bin": {
    "ast-mcp": "dist/ast-mcp.js"
  },
  "bugs": {
    "url": "https://github.com/mwillbanks/ast-mcp/issues"
  },
  "dependencies": {
    "@ast-grep/lang-bash": "0.0.8",
    "@ast-grep/lang-c": "0.0.6",
    "@ast-grep/lang-cpp": "0.0.6",
    "@ast-grep/lang-csharp": "0.0.6",
    "@ast-grep/lang-dart": "0.0.7",
    "@ast-grep/lang-elixir": "0.0.7",
    "@ast-grep/lang-go": "0.0.6",
    "@ast-grep/lang-java": "0.0.7",
    "@ast-grep/lang-kotlin": "0.0.7",
    "@ast-grep/lang-lua": "0.0.7",
    "@ast-grep/lang-markdown": "0.0.6",
    "@ast-grep/lang-php": "0.0.7",
    "@ast-grep/lang-python": "0.0.6",
    "@ast-grep/lang-ruby": "0.0.7",
    "@ast-grep/lang-rust": "0.0.7",
    "@ast-grep/lang-scala": "0.0.7",
    "@ast-grep/lang-sql": "0.0.8",
    "@ast-grep/lang-swift": "0.0.8",
    "@ast-grep/lang-toml": "0.0.9",
    "@ast-grep/lang-yaml": "0.0.6",
    "@ast-grep/napi": "0.51.0",
    "@huggingface/transformers": "4.3.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@posthog/mcp": "0.23.0",
    "apache-arrow": "21.2.0",
    "diff-match-patch-ts": "^2.0.0",
    "onnxruntime-common": "1.30.0",
    "parse5": "8.0.1",
    "posthog-node": "5.56.4",
    "tree-sitter-systemverilog": "0.4.1",
    "tree-sitter-wasm": "2.0.4",
    "typescript-strada": "npm:@typescript/typescript6@6.0.2",
    "unbash": "^6.0.1",
    "web-tree-sitter": "0.27.1",
    "zod": "^4.6.7"
  },
  "description": "Zero-trust MCP file writes, native code intelligence, graph retrieval, hooks, and agent skills",
  "devDependencies": {
    "@lancedb/lancedb": "0.40.0",
    "@modelcontextprotocol/inspector": "^2.11.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "apache-arrow-18": "npm:apache-arrow@18.1.0",
    "fallow": "^3.34.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "files": [
    "dist",
    "src",
    "templates",
    "README.md",
    "CONTRIBUTING.md",
    "logo.svg",
    "LICENSE"
  ],
  "homepage": "https://mwillbanks.github.io/ast-mcp/",
  "keywords": [
    "ast",
    "ast-grep",
    "coding-agents",
    "mcp",
    "model-context-protocol",
    "secure-code-editing"
  ],
  "license": "MIT",
  "name": "@mwillbanks/ast-mcp",
  "optionalDependencies": {
    "@lancedb/lancedb-darwin-arm64": "0.40.0",
    "@lancedb/lancedb-linux-arm64-gnu": "0.40.0",
    "@lancedb/lancedb-linux-arm64-musl": "0.40.0",
    "@lancedb/lancedb-linux-x64-gnu": "0.40.0",
    "@lancedb/lancedb-linux-x64-musl": "0.40.0",
    "@lancedb/lancedb-win32-arm64-msvc": "0.40.0",
    "@lancedb/lancedb-win32-x64-msvc": "0.40.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "packageManager": "bun@1.4.4",
  "preferUnplugged": true,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwillbanks/ast-mcp.git"
  },
  "scripts": {
    "build": "bun run scripts/build/build.ts",
    "check": "bun run tools:check && bun run templates:check && bun run prose:check && bun run lint && bun run test",
    "check:coverage": "bun run tools:check && bun run templates:check && bun run prose:check && bun run lint && bun run test:coverage",
    "dev": "bun run --watch src/index.ts",
    "dev:http": "bun run --watch src/http/entry.ts",
    "evals:check": "bun run templates/skills/ast-mcp/evals/validate.ts",
    "evals:measure": "bun run templates/skills/ast-mcp/evals/measure.ts",
    "evals:score": "bun run templates/skills/ast-mcp/evals/measure.ts --strict",
    "fallow": "fallow --skip health",
    "fallow:health": "fallow health",
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "format:files": "bun fmt",
    "inspect": "bunx @modelcontextprotocol/inspector bun run src/index.ts",
    "inspect:http": "bunx @modelcontextprotocol/inspector",
    "intelligence:measure": "bun run scripts/benchmark/benchmark-intelligence-baseline.ts",
    "intelligence:qualify": "bun run scripts/validation/qualify-intelligence-deps.ts",
    "lint": "bun run format:check && bun run typecheck && bun run boundaries:check",
    "prepack": "bun run build",
    "prose:check": "bun run scripts/validation/check-prose-cli.ts",
    "skill:check": "bunx skills-ref validate templates/skills/ast-mcp",
    "smoke:hosts": "bun run scripts/testing/host-smoke.ts",
    "start": "bun run src/index.ts",
    "start:http": "bun run src/http/entry.ts",
    "templates:check": "bun run scripts/validation/check-template-drift.ts",
    "templates:sync": "bun run scripts/validation/check-template-drift.ts --write",
    "test": "bun test --dots --bail --max-concurrency=1 --timeout=30000",
    "test:coverage": "bun test --coverage --dots --bail --max-concurrency=1 --timeout=30000",
    "tools:check": "bun run scripts/validation/verify-tools.ts",
    "typecheck": "bun check --no-script",
    "boundaries:check": "bun run scripts/validation/check-runtime-imports.ts"
  },
  "sideEffects": false,
  "type": "module",
  "version": "0.6.6"
}
